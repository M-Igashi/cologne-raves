{
  "name": "cologne-raves",
  "description": "Cologne Raves - Event tracking and management system for Cologne's music scene.",
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.6",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "file-saver": "^2.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build && node scripts/fix-sitemap.js",
