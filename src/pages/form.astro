---
import Base from '../layouts/Base.astro';
import EventForm from '../components/EventForm.tsx';
import { SITE_URL } from '../utils/seo';
---

<Base
  title="Submit a Party or Rave in Cologne | Cologne Raves"
  description="Add your techno party, rave, or club night to the Cologne Raves community calendar. Fill in the details or paste an event link. Free, no account needed."
  canonicalURL={`${SITE_URL}/form/`}
  breadcrumb="Submit an event"
  active="submit"
>
  <section class="hero hero-compact wrap">
    <p class="kicker">Community calendar · free listing · Köln</p>
    <h1 class="hero-title">Submit <em>your event</em></h1>
    <p class="hero-sub">Promoter, venue, or raver: put your party in front of Cologne. Fill in the details or just paste a link.</p>
  </section>

  <div class="wrap form-shell">
    <EventForm client:load />
  </div>
</Base>
