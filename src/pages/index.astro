---
import { getISOWeek } from 'date-fns';
import Base from '../layouts/Base.astro';
import PartyCard from '../components/PartyCard.astro';
import Ticker from '../components/Ticker.astro';
import { getAllParties } from '../lib/getAllParties';
import { getBerlinWeekRange } from '../lib/getFeaturedParties';
import { SITE_URL, eventJsonLd, formatDate, topVenues } from '../utils/seo';

const { start, end } = getBerlinWeekRange();
const allParties = await getAllParties();
const upcoming = allParties.filter((party) => party.date >= start);
const parties = upcoming.filter((party) => party.date <= end);

const days = [...new Set(parties.map((party) => party.date))].map((date) => ({
  date,
  parties: parties.filter((party) => party.date === date),
}));

const venues = topVenues(upcoming);
const weekVenueCount = new Set(parties.map((party) => party.venue)).size;
const weekNumber = getISOWeek(new Date(start));
const weekRange = `${formatDate(start, { day: 'numeric', month: 'short' })} to ${formatDate(end, { day: 'numeric', month: 'short', year: 'numeric' })}`;

const faq = [
  {
    question: 'What is Cologne Raves?',
    answer: 'A community-run calendar of techno parties, raves, and electronic music events in Cologne (Köln). It is maintained by volunteers from the Cologne Ravers WhatsApp group, with no ads and no cookies.',
  },
  {
    question: 'Which clubs and venues are covered?',
    answer: `Anything electronic in and around Cologne: club nights, open airs, day raves, and festivals. Venues with upcoming dates include ${venues.slice(0, 8).join(', ')}, and more.`,
  },
  {
    question: 'How do I add my party?',
    answer: 'Use the submission form: fill in the details or just paste a link to the event page. Promoters, venues, and ravers are all welcome to submit.',
  },
  {
    question: 'Is it free?',
    answer: 'Yes. The calendar is free to use and free to list on. It is an open-source hobby project with no commercial interest.',
  },
];

// Length budget: title <=60 chars, description 70-160 chars.
const title = 'Cologne Raves: Techno Parties & Raves in Köln This Week';
const description = `${parties.length} techno parties, raves, and club nights in Cologne (Köln) this week, ${weekRange}. Lineups, venues, start times, and ticket links. No ads.`;

const jsonLd = [
  ...parties.map(eventJsonLd),
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<Base
  title={title}
  description={description}
  canonicalURL={`${SITE_URL}/`}
  pageType="CollectionPage"
  jsonLd={jsonLd}
  active="this-week"
>
  <section class="hero wrap">
    <p class="kicker">Week {weekNumber} <span lang="de">/ KW {weekNumber}</span> · {weekRange} · Köln</p>
    <h1 class="hero-title">Raves &amp; techno parties in Cologne <em>this week</em></h1>
    <p class="hero-sub">
      {parties.length} events at {weekVenueCount} venues, picked by the people who actually go.
      <span lang="de">Alle Techno-Partys, Raves und elektronischen Events in Köln diese Woche.</span>
    </p>
    <div class="hero-actions">
      <a href="/parties/" class="btn btn-acid">All {upcoming.length} upcoming events</a>
      <a href="/form/" class="btn">+ Submit event</a>
    </div>
  </section>

  <Ticker items={venues} />

  <div class="wrap">
    {days.length === 0 && (
      <p class="empty">Nothing listed for this week yet. <a href="/parties/">See all upcoming parties</a> or <a href="/form/">submit an event</a>.</p>
    )}

    {days.map((day) => (
      <section class="group" data-day={day.date}>
        <header class="group-head">
          <h2>
            {formatDate(day.date, { weekday: 'long' })}
            <span>{formatDate(day.date, { day: 'numeric', month: 'short' })}</span>
          </h2>
          <p class="group-count">{day.parties.length} {day.parties.length === 1 ? 'event' : 'events'}</p>
          <span class="live">Tonight</span>
        </header>
        <div class="group-events">
          {day.parties.map((party) => <PartyCard {...party} showEditLink={false} />)}
        </div>
      </section>
    ))}

    <p class="more">
      <a href="/parties/" class="btn btn-acid">All upcoming raves &amp; techno events in Cologne →</a>
    </p>

    <section class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">The fine print</h2>
      <dl>
        {faq.map(({ question, answer }) => (
          <div>
            <dt>{question}</dt>
            <dd>{answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</Base>
