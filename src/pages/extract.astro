---
import Base from '../layouts/Base.astro';
import ExtractEvents from "@/components/Extract";
import { getAllParties } from "@/lib/getAllParties";
import { SITE_URL } from '../utils/seo';

const allParties = await getAllParties();
---

<Base
  title="Extract Events | Cologne Raves"
  description="Internal tool: download Cologne Raves event data by date range."
  canonicalURL={`${SITE_URL}/extract/`}
  noindex={true}
>
  <div class="wrap form-shell">
    <ExtractEvents client:load allParties={allParties} />
  </div>
</Base>
