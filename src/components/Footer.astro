  <script type="module">
    // The invite link stays out of the HTML so scrapers do not pick it up.
    function revealWhatsappLink() {
      const link = document.getElementById('whatsapp-link');
      if (link) {
        link.innerHTML = '<a href="https://chat.whatsapp.com/BtyIpZcgG671qCXV5lbhFI" target="_blank" rel="noopener">Join Cologne Ravers on WhatsApp</a>';
      }
    }
    globalThis.revealWhatsappLink = revealWhatsappLink;
