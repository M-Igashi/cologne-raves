---
import { eventTimes, formatDate, searchKey } from '../utils/seo';

const {
  id,
  title,
  venue,
  date,
  startTime,
  artists = [],
  url,
  sourceFile,
  showDate = false,
  showEditLink = true,
} = Astro.props;

const { start } = eventTimes({ date, startTime });
const search = searchKey([title, venue, ...artists].join(' '));
---

<article class="event" data-day={showDate ? date : undefined} data-search={search}>
  <div class="event-when">
    {showDate && (
      <span class="event-date">
        <span>{formatDate(date, { weekday: 'short' })}</span>
        <b>{formatDate(date, { day: '2-digit' })}</b>
      </span>
    )}
    <time class="event-time" datetime={start}>{startTime || 'TBA'}</time>
    <span class="live">Tonight</span>
  </div>

  <div class="event-body">
    <h3 class="event-title">
      {url
        ? <a href={url} class="event-link" target="_blank" rel="noopener noreferrer">{title}</a>
        : title}
    </h3>
    {artists.length > 0 && <p class="event-artists">{artists.join(' · ')}</p>}
  </div>

  <div class="event-meta">
    {venue && <span class="event-venue">{venue}</span>}
    <span class="event-id">
      #{id}
      {showEditLink && sourceFile && (
        <a
          href={`https://github.com/M-Igashi/cologne-raves/edit/main/data/${sourceFile}`}
          target="_blank"
          rel="noopener noreferrer nofollow"
        >Edit</a>
      )}
    </span>
  </div>

  {url && <span class="event-arrow" aria-hidden="true">↗</span>}
</article>
