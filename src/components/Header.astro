---
const { active } = Astro.props;

const links = [
  { key: 'this-week', href: '/', label: 'This Week' },
  { key: 'all-parties', href: '/parties/', label: 'All Parties' },
];
---

<header class="site-header">
  <div class="wrap site-header-inner">
    <a href="/" rel="home" class="brand" aria-label="Cologne Raves home">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="16" fill="currentColor"></circle>
        <ellipse cx="11.2" cy="12" rx="2" ry="3.2" fill="#0b0b0a"></ellipse>
        <ellipse cx="20.8" cy="12" rx="2" ry="3.2" fill="#0b0b0a"></ellipse>
        <path d="M7.5 18.5c2 4.2 5 6.3 8.5 6.3s6.5-2.1 8.5-6.3" fill="none" stroke="#0b0b0a" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <span>Cologne Raves</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {links.map((link) => (
        <a href={link.href} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>
      ))}
      <a href="/form/" class="nav-cta" aria-current={active === 'submit' ? 'page' : undefined}>+ Submit Event</a>
    </nav>
  </div>
</header>
