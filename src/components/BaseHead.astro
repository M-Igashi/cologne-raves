---
import '../styles/global.css';
import { SITE_URL, SITE_NAME, OG_IMAGE } from '../utils/seo';

export interface Props {
  title: string;
  description: string;
  canonicalURL: string;
  noindex?: boolean;
  pageType?: string;
  breadcrumb?: string;
  jsonLd?: object[];
}

const {
  title,
  description,
  canonicalURL,
  noindex = false,
  pageType = "WebPage",
  breadcrumb,
  jsonLd = [],
} = Astro.props;

const ogImageAlt = "Cologne Raves: techno parties and raves in Köln";

const graph = [
  {
    "@type": "WebSite",
    "@id": `${SITE_URL}/#website`,
    name: SITE_NAME,
    alternateName: ["Köln Raves", "Cologne Rave Calendar", "Techno Events Cologne"],
    description: "Community-run calendar of techno parties, raves, and electronic music events in Cologne (Köln).",
    url: `${SITE_URL}/`,
    inLanguage: "en",
    publisher: { "@id": `${SITE_URL}/#organization` },
  },
  {
    "@type": "Organization",
    "@id": `${SITE_URL}/#organization`,
    name: SITE_NAME,
    alternateName: "Cologne Ravers WhatsApp Community",
    url: `${SITE_URL}/`,
    logo: { "@type": "ImageObject", url: `${SITE_URL}/favicon.png`, width: 512, height: 512 },
    sameAs: ["https://github.com/M-Igashi/cologne-raves"],
  },
  {
    "@type": pageType,
    "@id": `${canonicalURL}#webpage`,
    url: canonicalURL,
    name: title,
    description,
    isPartOf: { "@id": `${SITE_URL}/#website` },
    primaryImageOfPage: { "@type": "ImageObject", url: OG_IMAGE },
    dateModified: new Date().toISOString(),
    inLanguage: "en",
    ...(breadcrumb && { breadcrumb: { "@id": `${canonicalURL}#breadcrumb` } }),
  },
  ...(breadcrumb
    ? [{
        "@type": "BreadcrumbList",
        "@id": `${canonicalURL}#breadcrumb`,
        itemListElement: [
          { "@type": "ListItem", position: 1, name: SITE_NAME, item: `${SITE_URL}/` },
          { "@type": "ListItem", position: 2, name: breadcrumb, item: canonicalURL },
        ],
      }]
    : []),
  ...jsonLd,
];
---
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
<link rel="canonical" href={canonicalURL} />

<meta name="theme-color" content="#0b0b0a" />
<meta name="color-scheme" content="dark" />
<meta name="application-name" content={SITE_NAME} />
<meta name="apple-mobile-web-app-title" content={SITE_NAME} />
<meta name="geo.region" content="DE-NW" />
<meta name="geo.placename" content="Köln" />
<meta name="geo.position" content="50.937531;6.960279" />
<meta name="ICBM" content="50.937531, 6.960279" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={OG_IMAGE} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content="en_GB" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={OG_IMAGE} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />

<link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

<script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, '\\u003c')} />
