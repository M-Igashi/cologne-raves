{
  "name": "cologne",
  "compatibility_date": "2025-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "workers-site/index.js",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },

  "build": {
    "command": "npm run build"
  },

  // Workers AI turns event links and pasted text into a form prefill (/api/extract-event).
  "ai": {
    "binding": "AI"
  },

  // Per-visitor cap on auto-fill requests, on top of the Turnstile check.
  "ratelimits": [
    {
      "name": "EXTRACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],

  "triggers": {
    // Monday 00:30 UTC (01:30 CET / 02:30 CEST) — refresh "this week" early each Monday.
    // The scheduled handler dispatches the redeploy.yml workflow to rebuild & deploy.
    // NOTE: Cloudflare weekdays are 1=Sun..7=Sat, so use MON (not "1", which is Sunday).
    "crons": ["30 0 * * MON"]
  },

  "dev": {
    "port": 8787,
    "local_protocol": "http"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
